        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"incense\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"decision\" and r._field == \"state\")\n  |> map(fn: (r) => ({r with _value: if r._value == \"S0\" then 0.0 else if r._value == \"S1\" then 1.0 else if r._value == \"S2\" then 2.0 else if r._value == \"S3\" then 3.0 else -1.0}))\n  |> group(columns: [\"device\"])\n  |> last()",
          "refId": "A"
        }
      ],
      "title": "總覽狀態（每格一台爐）",
      "type": "stat"
    },
