/* =============================================================================
 * 智慧香爐 — 外購元件：5015 鼓風機
 * =============================================================================
 * ★★ 這不是列印件，是外購品的示意模型 ★★
 * 尺寸來自 ../params.scad，外形取自 params.scad 的 FAN_*（標稱值放餘量後的估值）。
 * 用途：組裝干涉檢查、螺絲可及性、目視確認裝得下。
 * ★不可當成實際尺寸寫進報告★（CLAUDE.md §7）
 *
 * 原點：本體左下角、z=0 為進氣面
 * ============================================================================= */

include <../params.scad>


// 離心式：軸向進氣（-z 面）、徑向出風（+x 面）
module blower_5015() {
    difference() {
        // 本體外緣就是標稱外形，★不畫外凸的出風嘴★——
        // 那是猜的，畫上去會在干涉檢查裡製造假陽性。
        color("#3a3f45") cube([FAN_W, FAN_H, FAN_T]);
        // 軸向進氣口（-z 面；裝進風扇座時會被鏡射成朝向煙道那一側）
        translate([FAN_W / 2, FAN_H / 2, -0.1])
            cylinder(h = 3, d = FAN_INLET_D, $fn = 64);
        // 徑向出風口（+x 面的開口，不外凸）
        translate([FAN_W - 3, FAN_H / 2 - FAN_OUT_H / 2, FAN_T / 2 - FAN_OUT_W / 2])
            cube([4, FAN_OUT_H, FAN_OUT_W]);
        // 安裝孔（M4 通孔——耳孔多為 ⌀4，★請實測★）
        for (x = [-1, 1], y = [-1, 1])
            translate([FAN_W / 2 + x * FAN_SCREW_S / 2,
                       FAN_H / 2 + y * FAN_SCREW_S / 2, -0.1])
                cylinder(h = FAN_T + 0.2, d = M4_CLEAR, $fn = 32);
    }
    // 葉輪（示意）
    color("#20242a") translate([FAN_W / 2, FAN_H / 2, 3])
        cylinder(h = FAN_T - 5, d = FAN_INLET_D - 4, $fn = 48);
}

// ── 單獨開檔時的預覽（被 use<> 引入時不執行）──
blower_5015();
