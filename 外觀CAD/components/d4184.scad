/* =============================================================================
 * 智慧香爐 — 外購元件：D4184 MOSFET 模組
 * =============================================================================
 * ★★ 這不是列印件，是外購品的示意模型 ★★
 * 尺寸來自 ../params.scad，為常見規格（估）。
 * 用途：組裝干涉檢查、螺絲可及性、目視確認裝得下。
 * ★不可當成實際尺寸寫進報告★（CLAUDE.md §7）
 *
 * 原點：PCB 左下角、z=0 為板底
 * ============================================================================= */

include <../params.scad>


module d4184() {
    color("#1c6b3c") linear_extrude(PCB_T) square([D4184_W, D4184_D]);
    // 兩組綠色端子台（12V 進、風扇出）
    color("#2e7d32") {
        translate([3, 2, PCB_T])               cube([D4184_W - 6, 8, D4184_TERM_H]);
        translate([3, D4184_D - 10, PCB_T])    cube([D4184_W - 6, 8, D4184_TERM_H]);
    }
    color("#8a8f94") {
        translate([4, 4, -0.2])
            cylinder(h = PCB_T + 0.4, d = 3.0, $fn = 24);
        translate([D4184_W - 4, D4184_D - 4, -0.2])
            cylinder(h = PCB_T + 0.4, d = 3.0, $fn = 24);
    }
}

// ── 單獨開檔時的預覽（被 use<> 引入時不執行）──
d4184();
