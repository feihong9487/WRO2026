/* =============================================================================
 * 智慧香爐 — 外購元件：金屬爐盆（使用者自備）
 * =============================================================================
 * ★★ 這不是列印件，是外購品的示意模型 ★★
 * 尺寸來自 ../params.scad，★BOWL_D／BOWL_H 為估值★，買到實體請實測後改 params.scad。
 * 用途：組裝干涉檢查、螺絲可及性、目視確認裝得下。
 * ★不可當成實際尺寸寫進報告★（CLAUDE.md §7）
 *
 * 原點：盆底圓心、z=0 為盆底外緣
 * ============================================================================= */

include <../params.scad>


// 常見不鏽鋼碗／香灰盆。非列印件——燃燒由金屬承接，塑膠不接觸火源。
module bowl() {
    color("#b9bec4") difference() {
        cylinder(h = BOWL_H, d = BOWL_D, $fn = 160);
        translate([0, 0, BOWL_WALL])
            cylinder(h = BOWL_H, d = BOWL_D - BOWL_WALL * 2, $fn = 160);
    }
}

// ── 單獨開檔時的預覽（被 use<> 引入時不執行）──
bowl();
