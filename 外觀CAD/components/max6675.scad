/* =============================================================================
 * 智慧香爐 — 外購元件：MAX6675 熱電偶轉換板 ＋ K 型探頭
 * =============================================================================
 * ★★ 這不是列印件，是外購品的示意模型 ★★
 * 尺寸來自 ../params.scad，★全為估值★。
 * 用途：組裝干涉檢查、螺絲可及性、目視確認裝得下。
 * ★不可當成實際尺寸寫進報告★（CLAUDE.md §7）
 *
 * 原點：轉換板左下角、z=0 為板底
 * ============================================================================= */

include <../params.scad>


module max6675_board() {
    color("#c0392b") linear_extrude(PCB_T) square([MAX6675_W, MAX6675_D]);
    color("#1a1a1a")
        translate([2, 2, PCB_T]) cube([MAX6675_W - 4, MAX6675_D - 4, MAX6675_H - PCB_T]);
}

// K 型探頭：★目前外觀 CAD 沒有任何支架把它固定在爐面上方★
// 交接文件要求懸於爐面上方 TC_TIP_ABOVE_BOWL，這裡把它畫出來，
// 是為了讓「缺少的支架」在組合件裡看得見，不是宣稱它已經有著落。
module tc_probe(len = 30) {
    color("#9aa0a6") cylinder(h = len, d = TC_PROBE_D, $fn = 32);
    color("#9aa0a6") translate([0, 0, len]) sphere(d = TC_PROBE_D, $fn = 32);
}

module max6675() {
    max6675_board();
    translate([MAX6675_W / 2, MAX6675_D / 2, MAX6675_H]) tc_probe(30);
}

// ── 單獨開檔時的預覽（被 use<> 引入時不執行）──
max6675();
