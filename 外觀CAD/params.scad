/* =============================================================================
 * 智慧香爐 — 尺寸參數（★唯一真相來源★）
 * =============================================================================
 * 本檔只有變數，沒有任何幾何。零件檔與元件檔都 include 它，改尺寸只改這一處。
 *
 * ★不要在零件檔裡寫死數字★ 寫死了就是第二份真相來源：
 *   改這裡不會生效，而驗證只讀得到這裡，兩邊會悄悄分岔。
 *
 * 相依：params.scad ← common.scad ← parts 底下的零件檔
 *                                 ← components 底下的元件檔
 *                                 ← incense_burner.scad（組合件＋驗證進入點）
 * ============================================================================= */
/* -----------------------------------------------------------------------------
 * ★檔名一律用 ASCII★
 * Windows 版 OpenSCAD 解析 include/use 路徑時不吃非 ASCII 字元——
 * 中文檔名或中文目錄名一律回報 "Can't open include file"，而且錯誤訊息
 * 本身是 CP950 編碼，連讀都讀不乾淨。註解裡的中文沒問題，只有路徑不行。
 * （2026-08-06 實測：中文.scad ✗、ascii.scad ✓、子目錄/x.scad ✗、sub/x.scad ✓）
 * ----------------------------------------------------------------------------- */

// ═══════════════════════════════════════════════════════════════════════════
// 列印參數
// ═══════════════════════════════════════════════════════════════════════════
NOZZLE      = 0.4;              // 噴嘴直徑
WALL        = NOZZLE * 6;       // 2.4mm＝6 走線，強度足夠且不浪費時間
FLOOR       = NOZZLE * 5;       // 2.0mm 底/頂厚（0.2 層高 × 10 層）
FIT         = 0.3;              // 組裝件之間的配合間隙（FDM 常用 0.2-0.4）
CHAMFER     = 1.2;              // 底緣倒角，改善首層附著
// ★切穿用的超出量★ 任何要「切開表面」的 difference()，被切體都必須
//   超出表面至少 OVER。停在共平面的位置時，CGAL 不保證切穿——
//   會留下一層退化薄膜，開口實際上是封死的，而且：
//     · 參數檢查抓不到（尺寸都對）
//     · Volumes=2 抓不到（封起來仍是合法的單一實體）
//     · F5 預覽看起來是開的（OpenCSG 容忍共平面），只有 F6／匯出 STL 才現形
//   集煙罩投香口踩過一次。是否觸發跟周邊幾何有關，不是每次共面都會出事——
//   正因為不可預測，才一律超出，不去賭這一次會不會過。
OVER        = 2;
BED         = 220;              // 列印床尺寸，驗證腳本會檢查零件是否放得下

// ═══════════════════════════════════════════════════════════════════════════
// 外型主尺寸
// ═══════════════════════════════════════════════════════════════════════════
BASE_W      = 180;              // 電子艙寬（也是整機最大寬度）
BASE_D      = 180;              // 電子艙深
BASE_H      = 62;               // 電子艙高

CHMB_W      = 156;              // 燃燒艙寬（比底座小，形成階梯造型）
CHMB_D      = 156;
CHMB_H      = 72;

HOOD_H      = 62;               // 集煙罩高
// ★漏斗狀集煙罩（2026-08-16 改版）★ 原本上窄下寬（罩頂縮口 96），
//   使用者插香要對準小口，不好用。改成「下段直筒＋上段外擴喇叭口」：
//     直筒段：外形與燃燒艙同寬（156），後方煙道開口與風扇座法蘭
//             都靠在這段的垂直後壁上——這段不能斜，斜了法蘭就貼不平。
//     喇叭段：直筒之上外擴到 HOOD_TOP_W，向上開的大口，插香不必對準。
//   列印仍為開口朝下倒印：喇叭斜面約 34°（<45°），免支撐。
HOOD_TOP_W  = 180;              // 罩頂開口外寬（＝BASE_W，內開口 ≈175）
HOOD_COLLAR_H = 44;             // 直筒段高。必須 ≥ 煙道開口上緣
                                //   （DUCT_Z_HOOD+DUCT_H＝36）再留餘量，
                                //   驗證CAD.py 的 F 檢查會驗這件事

CORNER_R    = 10;               // 外型圓角半徑——柔和的圓角讓造型接近傳統香爐

// ═══════════════════════════════════════════════════════════════════════════
// 燃燒區
// ═══════════════════════════════════════════════════════════════════════════
// ★使用者自備金屬爐盆★：常見不鏽鋼碗／香灰盆。買到後請實測並改這兩個值。
BOWL_D      = 110;              // 爐盆外徑
BOWL_H      = 45;               // 爐盆深度
BOWL_ALPHA  = 1;                // 組裝圖裡爐盆的不透明度（1=實心；見 assembly() 註解）
AIR_GAP     = 8;                // ★爐盆與塑膠之間的空氣間隙（絕熱關鍵）★
BOWL_LIP    = 4;                // 承接爐盆邊緣的環寬
RIB_W       = 6;                // 承接肋寬——僅 4 條，把導熱路徑降到最低

// 燃燒艙與電子艙之間的隔熱層
ISO_GAP     = 14;               // 空氣層厚度
ISO_VENT_W  = 5;                // 對流通風縫寬
ISO_RIB_W   = 3;                // 隔熱層支撐肋寬
ISO_RIB_N   = 3;                // 每軸肋條數
// ★為什麼要肋條★ 隔熱層是從底部挖空的，其天花板（爐盆井的樓板）
//   原本是 151mm 無支撐的水平面——列印時橋接跨距太長必定下垂。
//   肋條把跨距切成 ~38mm 的區塊，同時提升剛性。
//   刻意用細肋而非實心：導熱路徑降到最低，空氣層功能不受影響。

// ═══════════════════════════════════════════════════════════════════════════
// 螺絲規格
// ═══════════════════════════════════════════════════════════════════════════
// 指定：鎖固一律用 M4。
//
// ★但有三處鎖不了 M4，而且不是設計選擇的問題★
//   孔徑是外購板卡「自己」的孔，不在我們的圖上：
//     Raspberry Pi 5   官方安裝孔 Ø2.7  → 只能 M2.5
//     MATRIX Mini R4   UNO 相容孔 Ø3.2  → 只能 M3
//     D4184 MOSFET 模組 常見 Ø3.0       → 只能 M3
//   M4 螺絲桿徑 4.0 mm，物理上穿不過去。要嘛把板子的孔擴孔（會削掉
//   板邊銅箔與接地層，不建議），要嘛這三處照板子的規格走。此處選後者。
//
//   結論：★外殼、風扇、感測器艙一律 M4；板卡→殼依板子的孔徑★
M4_PILOT   = 3.3;    // M4 自攻進 PETG 的底孔（旋入式，不用螺帽）
M4_CLEAR   = 4.5;    // M4 通孔
M4_HEAD_D  = 8.0;    // M4 螺帽／華司外徑 → 決定螺柱、掛耳的最小尺寸
M4_ENGAGE  = 8.0;    // 自攻最小旋入深度（≒2×公稱徑，塑膠件的經驗值）

M3_PILOT   = 2.5;    // MATRIX / D4184
M25_PILOT  = 2.1;    // Raspberry Pi 5

// ═══════════════════════════════════════════════════════════════════════════
// 5015 鼓風機（離心式：軸向進氣、徑向出風）
// ═══════════════════════════════════════════════════════════════════════════
FAN_W       = 51;               // 本體寬（標稱 50，留餘量）
FAN_H       = 51;               // 本體高
FAN_T       = 16;               // 厚度（標稱 15）
FAN_INLET_D = 40;               // 軸向進氣口直徑
FAN_OUT_W   = 20;               // 徑向出風口寬
FAN_OUT_H   = 20;               // 徑向出風口高
FAN_SCREW_D = M4_CLEAR;         // M4 通孔（風扇耳孔多為 Ø4，M4 可過；★請實測★）
FAN_SCREW_S = 42;               // 螺絲孔間距（5015 常見值，請實測確認）

// 煙道
// ★煙道只開在集煙罩上★ 煙從爐盆上升、在罩內聚集，那裡才是該抽的位置。
//   原本燃燒艙也開了一個，位置在爐盆側面（煙不會往那走），
//   而且與罩子的開口差 12mm 完全對不上——2026-08-02 移除。
DUCT_W      = 46;               // 煙道寬
DUCT_H      = 30;               // 煙道高
DUCT_Z_HOOD = 6;                // 開口下緣在集煙罩局部座標的高度
PAD_MARGIN  = 7;                // 風扇安裝墊台四周比開口多出的邊

// ═══════════════════════════════════════════════════════════════════════════
// 電子元件（★以下尺寸多為估值，拿到實體請實測後修改★）
// ═══════════════════════════════════════════════════════════════════════════
// MATRIX Mini R4：官方未公佈尺寸。以 Arduino UNO 外型（68.6×53.4）為基礎，
// 因周邊埠較多而放寬。★務必實測★
MATRIX_W    = 90;    MATRIX_D = 70;    MATRIX_SCREW = [[4,4],[86,4],[4,66],[86,66]];
// Raspberry Pi 5：官方尺寸 85×56，螺孔 58×49 間距、距邊 3.5
PI_W        = 85;    PI_D     = 56;    PI_SCREW    = [[3.5,3.5],[61.5,3.5],[3.5,52.5],[61.5,52.5]];
// D4184 MOSFET 模組：常見尺寸
D4184_W     = 42;    D4184_D  = 34;

STANDOFF_H  = 6;                // 螺柱高（板底離殼底的距離，留走線空間）
// 螺柱外徑由底孔決定：孔壁至少要留 2.4mm（＝6 條 0.4 走線）才不會旋裂。
// 板卡螺柱走 M3/M2.5（見上方「螺絲規格」說明），不是 M4。
function standoff_od(pilot) = pilot + 2 * WALL;
STANDOFF_D  = standoff_od(M3_PILOT);   // = 7.3

// ═══════════════════════════════════════════════════════════════════════════
// 外購元件的高度與連接器（components 底下的 .scad 用）
// ═══════════════════════════════════════════════════════════════════════════
// ★★ 以下數字全部是估值，沒有任何一個實測過 ★★（CLAUDE.md §7）
//   用途是「裝得下嗎、會不會打架、螺絲鎖得到嗎」的干涉檢查與目視確認，
//   ★不可當成實際尺寸寫進報告★。拿到實體請逐項量過再改這裡。
//   Raspberry Pi 5 的板外形（85×56）與孔位是官方公開值，算是可信；
//   連接器高度是常見規格；MATRIX Mini R4 官方未公佈，整組都是推估。
PCB_T          = 1.6;    // 一般 FR4 板厚

// Raspberry Pi 5
PI_RJ45_L      = 21.3;   PI_RJ45_W = 15.9;  PI_RJ45_H = 13.5;   // 含外露 3mm
PI_USB_L       = 17.3;   PI_USB_W  = 13.5;  PI_USB_H  = 15.9;   // 雙層 USB-A
PI_GPIO_L      = 50.8;   PI_GPIO_W = 5.0;   PI_GPIO_H = 8.5;    // 2×20 排針
PI_USBC_W      = 9.0;    PI_USBC_H = 3.5;
PI_HDMI_W      = 7.0;    PI_HDMI_H = 3.5;

// MATRIX Mini R4（★官方未公佈外形，整組推估★）
MATRIX_CONN_H  = 12.0;   // 周邊埠座高度
MATRIX_USB_W   = 9.0;    MATRIX_USB_H = 3.5;   // USB-C 供電/燒錄

// D4184 MOSFET 模組
D4184_TERM_H   = 11.0;   // 綠色端子台高度

// 感測器模組厚度（PCB ＋ 感測器本體）
SCD41_T        = PCB_T + 7.0;   // SCD41 本體約 10.1×10.1×6.5
SHT31_T        = PCB_T + 3.0;

// MAX6675 熱電偶轉換板 ＋ K 型探頭
MAX6675_W      = 25.0;   MAX6675_D = 15.0;  MAX6675_H = 9.0;
TC_PROBE_D     = 6.0;    TC_PROBE_L = 50.0;
// ★交接文件說熱電偶懸於爐面上方 2–3cm，但目前外觀 CAD 沒有任何支架★
//   這個高度只是把「應該在哪」畫出來，讓缺少的支架看得見。
TC_TIP_ABOVE_BOWL = 25.0;

// ── 超音波霧化（無明火展示的煙源）──────────────────────────
// 壓電片泡在水裡震出冷霧：不放 CO2（乾冰會頂穿硬警報、汙染人潮偵測的論述）、
// 完全不熱、可滴精油做香氣。現有金屬爐盆直接當水盤。
// ★冷霧不像熱煙會自然上升★，靠 5015 鼓風機的抽吸拉進集煙罩——
//   待機時霧在盆上積著、CO2 一升高風扇轉起來就看著被吸走，展示效果反而更好。
//   但集煙罩對非浮升煙源抓不抓得到，★只有實體吹過才知道★。
MIST_DISC_D    = 20;     // 壓電片直徑
MIST_MOD_D     = 26;     // 模組外徑（含浮座）
MIST_MOD_H     = 12;
MIST_WATER_MM  = 20;     // 建議水位（壓電片要沒入水中）
// 罩內 LED 側光：霧被側向打光時可見度差好幾倍，成本幾十塊
HOODLED_W      = 60;  HOODLED_H = 4;  HOODLED_T = 3;

// 金屬爐盆壁厚（示意用）
BOWL_WALL      = 1.5;
// 爐盆的圓弧細分。預覽時要高（Ø110 用 48 段看得出稜線，就是「爐面條紋」的來源之一）；
// 匯出 STEP 時由匯出腳本傳 -D BOWL_FN=0 降下來，改吃自適應的 $fa/$fs。
BOWL_FN        = 160;

// 感測器艙的模組定位肋
// ★深度必須吃得下最厚的模組★ 原本寫死 4mm，是在還沒有元件模型時憑感覺給的；
//   SCD41 連感測器本體有 8.6mm，4mm 的肋根本夾不到 PCB。
//   加了 components/sensors.scad 才看出來——這就是把外購件畫出來的價值。
// ★兩組模組在「深度」方向錯開，不是只在高度方向錯開★
//   兩組肋若都貼著前壁、都從艙底長上來，SHT31 的肋（x 18.7/40.3）就落在
//   SCD41 板寬（18.5–43.5）之內，直接刺進 SCD41 的 PCB。
//   這是加了 components 的元件模型之後，檢查 M 才抓到的（穿透 202mm³）——
//   只驗殼對殼的時候完全看不出來。
POD_RIB_W      = 3;
POD_RIB_D_SCD  = SCD41_T + 1.5;          // 前排：SCD41
POD_RIB_D_SHT  = SHT31_T + 1.5;          // 後排：SHT31
POD_Y_SCD      = WALL;                   // 前排肋的起始 y（貼前壁）
POD_Y_SHT      = WALL + SCD41_T + 2;     // 後排讓開 SCD41 的板厚再加 2mm 餘隙

// ═══════════════════════════════════════════════════════════════════════════
// 感測器艙（前方，遠離熱源，朝向參拜者呼吸帶）
// ═══════════════════════════════════════════════════════════════════════════
POD_W       = 62;
POD_D       = 26;
POD_H       = 58;   // 需容納兩模組堆疊（驗證腳本會檢查）
SCD41_W     = 25;    SCD41_D = 21;     // GY-SCD41 模組（估值，請實測）
SHT31_W     = 18;    SHT31_D = 14;     // GY-SHT31-D 模組（估值，請實測）
// 背面掛耳：M4×2 鎖到底座前壁。厚度與高度要吃得住 M4 的鎖緊力，
// 孔緣到耳邊至少留 M4_HEAD_D/2，否則鎖下去會把耳朵撕開。
// ★掛耳必須橫跨整個背面開口★ 背面是全開的，中央一小片掛耳沒有任何
//   東西可以接——會變成浮空的獨立實體（CGAL Volumes 會從 2 變 3）。
//   所以做成一條橫樑，兩端埋進側壁、上緣埋進頂壁，三面都咬住。
POD_EAR_T     = 5;                     // 掛耳厚（M4 通孔穿過）
POD_EAR_H     = 14;                    // ≥ M4_HEAD_D + 2×壁厚
POD_EAR_PITCH = 20;                    // 兩孔間距
POD_EAR_EMBED = 1;                     // 埋進側壁／頂壁的深度（確保實體相交而非共面）
POD_EAR_W     = POD_W - WALL * 2 + POD_EAR_EMBED * 2;
POD_EAR_X     = WALL - POD_EAR_EMBED;
POD_EAR_Z     = POD_H - FLOOR + POD_EAR_EMBED - POD_EAR_H;
// 前面通風槽的 x 位置。定位肋佔用的 x 區間（艙寬 62、中心 31）：
//   SCD41 肋 15.2–18.2、43.8–46.8　｜　SHT31 肋 18.7–21.7、40.3–43.3
// 剩下的淨空帶：2.4–15.2 / 21.7–40.3 / 46.8–59.6，槽只能開在這三帶裡。
// 槽寬 3.5，所以中心距肋緣至少要 1.75+1.2。★驗證腳本 L 會檢查★
POD_VENT_X    = [9, 25, 31, 37, 53];

// ═══════════════════════════════════════════════════════════════════════════
// （2026-08-16 移除：理香機構）
// ═══════════════════════════════════════════════════════════════════════════
// 插孔板／磁座／導正套筒／電磁鐵整組自設計移除（使用者決定）。
// 香直接插進爐盆，投香口改為漏斗大口（見上方 HOOD_TOP_W 段）。
// ═══════════════════════════════════════════════════════════════════════════
// 定位榫（層與層之間的對位）
// ═══════════════════════════════════════════════════════════════════════════
TENON_D     = 8;                // 榫柱直徑
TENON_H     = 6;                // 榫柱高
LEDGE_W     = 11;               // 頂緣內側承接台階寬——榫柱要坐在實體上，不能懸空
LEDGE_H     = 3;                // 台階高
TENON_INSET = WALL + LEDGE_W / 2;  // ★必須落在台階上★（原本 22 會讓榫柱浮空）

$fn = 48;                       // 圓弧精細度（算繪時可調高到 96）
