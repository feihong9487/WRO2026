# ── Python ──
__pycache__/
*.py[cod]
.pytest_cache/

# ── 自動化產生的 log ──
auto_loop_*.log

# ── STEP 匯出與其相依 ──
# STEP 是 .scad 的衍生檔，可隨時用 export_step.py 重產；
# 而且單檔就好幾 MB，不該進版控。
外觀CAD/STEP/
外觀CAD/.venv/
外觀CAD/.stepexp_*/
*.step

# ── CAD / EDA 的暫存與衍生檔 ──
# 原始檔（.scad / 產生器 .py）才是真相來源，衍生檔可隨時重產
外觀CAD/.scadchk_*/
外觀CAD/_t_*.stl
外觀CAD/_test.stl
CAD自檢/_selftest.*
*.stl

# KiCad 個人偏好與鎖定檔（.kicad_pro / .kicad_sch 要進版控）
*.kicad_prl
*~*.lck
*.kicad_sch-bak
*-backups/
.history/

# ── 備份 ──
*.orig
*.bak

# ── 作業系統 ──
Thumbs.db
desktop.ini
.DS_Store

